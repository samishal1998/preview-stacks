{
  "name": "preview-stacks-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.12",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "release:plan": "publish-kit plan",
    "release:dry": "publish-kit publish --dry-run",
    "release:publish": "publish-kit publish"
  },
  "devDependencies": {
    "@samyx/publish-kit": "^0.0.0-pre.1",
    "turbo": "^2.5.6"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "author": "sami.mishal"
}
