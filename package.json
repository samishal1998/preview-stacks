{
  "name": "@samyx/preview-stacks",
  "version": "0.1.0",
  "description": "Declarative lifecycle for ephemeral per-PR preview stacks: isolation axes with provision/destroy/leak-verification, over Docker Compose.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samishal1998/preview-stacks.git"
  },
  "homepage": "https://github.com/samishal1998/preview-stacks#readme",
  "bugs": {
    "url": "https://github.com/samishal1998/preview-stacks/issues"
  },
  "type": "module",
  "bin": {
    "pstack": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/spec.ts"
  },
  "workspaces": [
    "."
  ],
  "files": [
    "src",
    "ui",
    "examples",
    "skills",
    "docs",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit",
    "release:plan": "publish-kit plan",
    "release:dry": "publish-kit publish --dry-run",
    "release:publish": "publish-kit publish"
  },
  "keywords": [
    "preview-environments",
    "ephemeral-environments",
    "docker-compose",
    "traefik",
    "ci-cd",
    "pull-request",
    "monorepo",
    "devops",
    "bun"
  ],
  "devDependencies": {
    "@samyx/publish-kit": "^0.0.0-pre.1",
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "author": "sami.mishal",
  "publishConfig": {
    "access": "public"
  }
}
