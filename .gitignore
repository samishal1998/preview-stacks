node_modules/
*.log
.DS_Store
dist/
*.tgz

# Filled-in cloud-configs: they carry a real ACME email and a dashboard password. Commit the
# `.tpl.yaml` template instead — a credential in git history cannot be un-committed.
**/examples/cloud-init.*.yaml
!**/examples/cloud-init.*.tpl.yaml
.turbo/

# Generated cloud-configs for a specific host. `pstack cloud-init > my-host.yml` is a normal thing
# to do in the working tree, and the result names one operator's domain and dashboard — it belongs
# to them, not to the repo. (One was committed by accident; it carried no credential, because the
# generator embeds none — tokens are minted at boot.)
hetzner*.yml
*.cloud-init.yml

# GoReleaser`s pre-build scratch (the version-stamped installer).
.build/

# CI writes one at the workspace root to authenticate `bun publish`; never commit a token.
.npmrc

# `pstack pull config` exports. Sealed, but a sealed file plus a passphrase that leaks later is
# still every credential of a host — and unlike the cloud-configs above, this one is NOT harmless
# without its key: it is offline-crackable at leisure. The docs name it `host.sealed`; the other
# shapes are what people actually type. A credential in git history cannot be un-committed.
*.sealed
config.yaml
.config.yaml
