  "documents": [
    {
      "name": "key order is insertion order",
      "yaml": "z: 1\na: 2\nm: 3\n\"1\": 4\n\"0\": 5\n",
      "value": {
        "0": 5,
        "1": 4,
        "z": 1,
        "a": 2,
        "m": 3
      },
      "json": "{\"0\":5,\"1\":4,\"z\":1,\"a\":2,\"m\":3}"
    },
    {
      "name": "duplicate keys",
      "yaml": "a: 1\nb: 2\na: 3\n",
      "value": {
        "a": 3,
        "b": 2
      },
      "json": "{\"a\":3,\"b\":2}"
    },
    {
      "name": "anchors and aliases",
      "yaml": "base: &b\n  x: 1\n  y: [1, 2]\nref: *b\n",
      "value": {
        "base": {
          "x": 1,
          "y": [
            1,
            2
          ]
        },
        "ref": {
          "x": 1,
          "y": [
            1,
            2
          ]
        }
      },
      "json": "{\"base\":{\"x\":1,\"y\":[1,2]},\"ref\":{\"x\":1,\"y\":[1,2]}}"
    },
    {
      "name": "merge keys",
      "yaml": "base: &b\n  x: 1\n  y: 2\nchild:\n  <<: *b\n  y: 9\n  z: 3\n",
      "value": {
        "base": {
          "x": 1,
          "y": 2
        },
        "child": {
          "y": 9,
          "x": 1,
          "z": 3
        }
      },
      "json": "{\"base\":{\"x\":1,\"y\":2},\"child\":{\"y\":9,\"x\":1,\"z\":3}}"
    },
    {
      "name": "multi-document",
      "yaml": "a: 1\n---\nb: 2\n",
      "value": [
        {
          "a": 1
        },
        {
          "b": 2
        }
      ],
      "json": "[{\"a\":1},{\"b\":2}]"
    },
    {
      "name": "block scalars",
      "yaml": "lit: |\n  line1\n  line2\nfold: >\n  one\n  two\n\n  three\nkeep: |+\n  x\n\nstrip: |-\n  y\n",
      "value": {
        "lit": "line1\nline2\n",
        "fold": "one two\nthree\n",
        "keep": "x\n\n",
        "strip": "y"
      },
      "json": "{\"lit\":\"line1\\nline2\\n\",\"fold\":\"one two\\nthree\\n\",\"keep\":\"x\\n\\n\",\"strip\":\"y\"}"
    },
    {
      "name": "flow collections",
      "yaml": "seq: [1, \"2\", three, null, ~, true]\nmap: {a: 1, b: [x, y], c: {d: e}}\nempty: []\nemptymap: {}\n",
      "value": {
        "seq": [
          1,
          "2",
          "three",
          null,
          null,
          true
        ],
        "map": {
          "a": 1,
          "b": [
            "x",
            "y"
          ],
          "c": {
            "d": "e"
          }
        },
        "empty": [],
        "emptymap": {}
      },
      "json": "{\"seq\":[1,\"2\",\"three\",null,null,true],\"map\":{\"a\":1,\"b\":[\"x\",\"y\"],\"c\":{\"d\":\"e\"}},\"empty\":[],\"emptymap\":{}}"
    },
    {
      "name": "quoted vs plain",
      "yaml": "a: 'single ''quoted'''\nb: \"double \\\"quoted\\\" \\n newline\"\nc: plain # comment\nd: 'yes'\ne: \"0755\"\n",
      "value": {
        "a": "single 'quoted'",
        "b": "double \"quoted\" \n newline",
        "c": "plain",
        "d": "yes",
        "e": "0755"
      },
      "json": "{\"a\":\"single 'quoted'\",\"b\":\"double \\\"quoted\\\" \\n newline\",\"c\":\"plain\",\"d\":\"yes\",\"e\":\"0755\"}"
    },
    {
      "name": "nulls in mappings",
      "yaml": "a:\nb: ~\nc: null\nd: \"\"\n",
      "value": {
        "a": null,
        "b": null,
        "c": null,
        "d": ""
      },
      "json": "{\"a\":null,\"b\":null,\"c\":null,\"d\":\"\"}"
    },
    {
      "name": "nested sequences of mappings",
      "yaml": "axes:\n  - name: a\n    up: \"true\"\n  - name: b\n    up: |\n      echo hi\n      echo there\n",
      "value": {
        "axes": [
          {
            "name": "a",
            "up": "true"
          },
          {
            "name": "b",
            "up": "echo hi\necho there\n"
          }
        ]
      },
      "json": "{\"axes\":[{\"name\":\"a\",\"up\":\"true\"},{\"name\":\"b\",\"up\":\"echo hi\\necho there\\n\"}]}"
    },
    {
      "name": "compose-shaped",
      "yaml": "services:\n  web:\n    image: nginx\n    ports:\n      - 80:80\n      - \"443:443\"\n    restart: no\n    labels:\n      - traefik.enable=true\n      - pstack.routing.port=80\n    environment:\n      A: yes\n      B: 0755\n      C: 1e3\n",
      "value": {
        "services": {
          "web": {
            "image": "nginx",
            "ports": [
              "80:80",
              "443:443"
            ],
            "restart": "no",
            "labels": [
              "traefik.enable=true",
              "pstack.routing.port=80"
            ],
            "environment": {
              "A": "yes",
              "B": 755,
              "C": 1000
            }
          }
        }
      },
      "json": "{\"services\":{\"web\":{\"image\":\"nginx\",\"ports\":[\"80:80\",\"443:443\"],\"restart\":\"no\",\"labels\":[\"traefik.enable=true\",\"pstack.routing.port=80\"],\"environment\":{\"A\":\"yes\",\"B\":755,\"C\":1000}}}}"
    },
    {
