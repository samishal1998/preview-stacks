{
  "name": "@samyx/preview-stacks",
  "version": "0.25.2",
  "description": "Declarative lifecycle for ephemeral per-PR preview stacks: isolation axes with provision/destroy/leak-verification, over Docker Compose.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samishal1998/preview-stacks.git"
  },
  "homepage": "https://github.com/samishal1998/preview-stacks#readme",
  "bugs": {
    "url": "https://github.com/samishal1998/preview-stacks/issues"
  },
  "type": "module",
  "bin": {
    "pstack": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:package": "bun scripts/check-package.ts",
    "check": "bun test && tsc --noEmit && bun scripts/build.ts && bun scripts/check-package.ts",
    "prepublishOnly": "bun scripts/build.ts"
  },
  "keywords": [
    "preview-environments",
    "ephemeral-environments",
    "docker-compose",
    "traefik",
    "ci-cd",
    "pull-request",
    "monorepo",
    "devops",
    "bun"
  ],
  "devDependencies": {
    "@samyx/publish-kit": "^0.0.0-pre.1",
    "@types/bun": "latest",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "author": "sami.mishal",
  "publishConfig": {
    "access": "public"
  }
}
